{
  "id": "midnight-grid",
  "name": "Midnight Grid",
  "version": "1.0.0",
  "description": "A quiet blue editor theme for long sessions, with the DSL keywords picked out and the noise turned down.",
  "author": "desmos-ide",
  "license": "Apache-2.0",
  "keywords": ["theme", "dark", "editor"],
  "icon": "icon.svg",
  "theme": {
    "dark": true,
    "editor": {
      "editor.background": "#0d1117",
      "editor.foreground": "#c6d0e0",
      "editorLineNumber.foreground": "#39415a",
      "editorLineNumber.activeForeground": "#7aa2f7",
      "editor.selectionBackground": "#20304d",
      "editor.lineHighlightBackground": "#131a26",
      "editorCursor.foreground": "#7aa2f7",
      "editorIndentGuide.background": "#1b2230",
      "editorWhitespace.foreground": "#222b3a",
      "editorBracketMatch.background": "#25324a",
      "editorBracketMatch.border": "#7aa2f7"
    },
    "tokens": {
      "keyword": "#7aa2f7",
      "identifier": "#c6d0e0",
      "number": "#f7c67a",
      "string": "#9ece6a",
      "comment": "#4a5568",
      "operator": "#89ddff",
      "delimiter": "#5d6b85",
      "type": "#bb9af7"
    }
  }
}
