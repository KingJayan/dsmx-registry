// every curve takes u from 0 to 1 and gives back 0 to 1

fn ease_in_quad(u) = u^2
fn ease_out_quad(u) = 1 - (1 - u)^2
fn ease_in_out_quad(u) = 2*u^2 where u < 0.5 else 1 - 2*(1 - u)^2

fn ease_in_cubic(u) = u^3
fn ease_out_cubic(u) = 1 + (u - 1)^3
fn ease_in_out_cubic(u) = 4*u^3 where u < 0.5 else 1 + 4*(u - 1)^3

// back overshoots the end and comes back to it
fn ease_in_back(u) = 2.70158*u^3 - 1.70158*u^2
fn ease_out_back(u) = 1 + 2.70158*(u - 1)^3 + 1.70158*(u - 1)^2

// elastic rings down to rest
fn ease_out_elastic(u) = 1 - cos(20*u)*exp(-6*u)
