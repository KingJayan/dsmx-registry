            "editorBracketMatch.background": "#25324a",
            "editorBracketMatch.border": "#7aa2f7"
          },
          "tokens": {
            "keyword": "#7aa2f7",
            "identifier": "#c6d0e0",
            "number": "#f7c67a",
            "string": "#9ece6a",
            "comment": "#4a5568",
            "operator": "#89ddff",
            "delimiter": "#5d6b85",
